# Server
PORT=5000
CLIENT_URL=http://localhost:3000

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/noteversity

# JWT
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# OTP
OTP_EXPIRY_MINUTES=10
ALLOWED_EMAIL_DOMAIN=paruluniversity.ac.in

# SMTP (use your institute mailer or a service like Gmail/SendGrid/Mailgun)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="Noteversity <no-reply@noteversity.app>"

# Gemini AI (for ChatBot PDF reading & RAG answers)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite

# Backup AI (xAI Grok fallback if Gemini fails)
XAI_API_KEY=your_xai_api_key_here
XAI_MODEL=grok-2-latest

